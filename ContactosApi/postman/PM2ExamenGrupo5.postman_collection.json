{
  "info": {
    "name": "PM2 Examen Grupo 5 - API de Contactos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección de la API de contactos con firma digital (image/png, máximo 1 MB). Antes de ejecutar, en Settings > General > Working directory seleccione la carpeta ContactosApi/postman."
  },
  "item": [
    {
      "name": "1 Contactos",
      "item": [
        {
          "name": "Crear contacto (POST multipart)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/contactos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contactos"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "nombre",
                  "value": "Jose de Jesus Sarmiento",
                  "type": "text"
                },
                {
                  "key": "telefono",
                  "value": "99765645",
                  "type": "text"
                },
                {
                  "key": "latitud",
                  "value": "14.0818",
                  "type": "text"
                },
                {
                  "key": "longitud",
                  "value": "-87.2068",
                  "type": "text"
                },
                {
                  "key": "archivo",
                  "type": "file",
                  "src": "archivos/firma_valida.png"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () { pm.response.to.have.status(201); });",
                  "const c = pm.response.json(); pm.environment.set(\"contactoId\", c.id); pm.test(\"Devuelve el id\", function () { pm.expect(c.id).to.be.above(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar contactos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/contactos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contactos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Es una lista\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar por texto",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/contactos?buscar=Jose",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contactos"
              ],
              "query": [
                {
                  "key": "buscar",
                  "value": "Jose"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener contacto por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/contactos/{{contactoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contactos",
                "{{contactoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Descargar firma (image/png)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/contactos/{{contactoId}}/archivo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contactos",
                "{{contactoId}}",
                "archivo"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Content-Type image/png\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"image/png\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar contacto (PUT)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/contactos/{{contactoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contactos",
                "{{contactoId}}"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "nombre",
                  "value": "Jose de Jesus Sarmiento Actualizado",
                  "type": "text"
                },
                {
                  "key": "telefono",
                  "value": "99887766",
                  "type": "text"
                },
                {
                  "key": "latitud",
                  "value": "14.0820",
                  "type": "text"
                },
                {
                  "key": "longitud",
                  "value": "-87.2070",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
